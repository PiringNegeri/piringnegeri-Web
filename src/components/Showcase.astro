---
---

<section class="w-full px-6 lg:px-12 py-16">
  <div class="grid grid-cols-1 md:grid-cols-12 gap-4 lg:gap-6 max-w-7xl mx-auto h-auto md:h-[400px]">
    <!-- Dark Card -->
    <div class="md:col-span-3 bg-card-dark text-white rounded-[2rem] p-8 flex flex-col h-full min-h-[250px] shadow-lg">
      <h3 class="text-xs text-slate-400 mb-2 uppercase tracking-widest font-medium">Showcase</h3>
      <h2 class="text-3xl lg:text-4xl font-semibold mb-auto leading-tight">Protfolice<br/>Byo 510</h2>
      <p class="text-slate-400 text-sm mt-4 mb-8">Modern management</p>
      <button class="bg-primary hover:bg-primary-hover text-white text-sm font-medium py-3 px-6 rounded-full transition-colors self-start mt-auto shadow-md">
        Check More
      </button>
    </div>

    <!-- Images Column -->
    <div class="md:col-span-3 flex flex-col gap-4 lg:gap-6 h-[400px] md:h-auto">
      <div class="flex-1 rounded-[2rem] overflow-hidden bg-slate-200 shadow-sm relative group">
        <img src="/images/showcase_docs.png" alt="Documents" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
      </div>
      <div class="flex-1 rounded-[2rem] overflow-hidden bg-slate-200 shadow-sm relative group">
        <img src="/images/showcase_laptop.png" alt="Laptop Working" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
      </div>
    </div>

    <!-- Right Section -->
    <div class="md:col-span-6 grid grid-cols-1 sm:grid-cols-2 gap-4 lg:gap-6 h-auto md:h-full">
      <!-- Stat Card -->
      <div class="bg-white rounded-[2rem] p-8 flex flex-col justify-center shadow-sm h-[250px] sm:h-auto border border-slate-100">
        <p class="text-slate-800 font-medium mb-4 text-lg leading-tight">Increased productivity<br/>by elodiety</p>
        <div class="text-6xl font-bold text-slate-800 mb-2 tracking-tighter">30%</div>
        <p class="text-slate-400 text-sm mt-auto">Access to modern tools</p>
      </div>
      
      <!-- Dashboard Mock -->
      <div class="bg-slate-50/80 rounded-[2rem] p-6 flex items-center justify-center overflow-hidden h-[250px] sm:h-auto shadow-inner border border-slate-100 relative group">
         <!-- Mock UI floating -->
         <div class="w-full h-full max-h-48 bg-white rounded-2xl shadow-lg shadow-slate-200/50 border border-slate-100 p-5 flex flex-col gap-4 transform transition-transform duration-500 group-hover:-translate-y-2 group-hover:rotate-1">
           <div class="flex justify-between items-center mb-2">
             <div class="w-1/3 h-2.5 bg-slate-200 rounded-full"></div>
             <div class="w-8 h-8 bg-primary/10 rounded-full flex items-center justify-center">
                <div class="w-3 h-3 bg-primary rounded-full"></div>
             </div>
           </div>
           
           <!-- Chart lines mock -->
           <div class="flex-1 flex items-end gap-2 mt-4">
              <div class="w-1/6 bg-blue-100 h-1/3 rounded-t-sm"></div>
              <div class="w-1/6 bg-blue-200 h-1/2 rounded-t-sm"></div>
              <div class="w-1/6 bg-blue-300 h-3/4 rounded-t-sm"></div>
              <div class="w-1/6 bg-primary/60 h-full rounded-t-sm"></div>
              <div class="w-1/6 bg-primary h-5/6 rounded-t-sm"></div>
           </div>
         </div>
      </div>
    </div>
  </div>
</section>

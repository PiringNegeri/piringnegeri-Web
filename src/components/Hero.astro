---
import { ArrowRight } from "lucide-react";
---

<section class="w-full px-6 lg:px-12 pt-32 pb-12 lg:pt-16 lg:pb-20 flex flex-col lg:flex-row items-center gap-12 lg:gap-8">
  <div class="flex-1 flex flex-col items-start max-w-2xl">
    <h1 class="text-5xl lg:text-7xl font-semibold text-slate-800 leading-[1.1] mb-6 tracking-tight">
      Dari Negeri<br />Untuk Negeri
    </h1>
    <p class="text-slate-500 text-lg mb-10 max-w-md leading-relaxed">
      Pantau dan Laporkan Program Makan Bergizi Gratis dari Badan Gizi Nasional untuk memaksimalkan seluruh 6767 Satuan Pelayanan Pemenuhan Gizi di Indonesia
    </p>
    
    <div class="flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto">
      <button class="w-full sm:w-auto bg-primary hover:bg-primary-hover text-white text-sm font-medium py-3.5 px-8 rounded-full transition-colors shadow-sm">
        Buat Laporan
      </button>
      <button class="w-full sm:w-auto flex items-center justify-center gap-2 bg-slate-50 hover:bg-slate-100 text-primary text-sm font-medium py-3.5 px-8 rounded-full transition-colors group">
        Lihat Laporan Publik
        <ArrowRight size={16} className="group-hover:translate-x-1 transition-transform" />
      </button>
    </div>
  </div>

  <div class="flex-1 w-full relative mt-16 lg:mt-0 flex justify-center items-center">
    <!-- Container for the shape and image -->
    <div class="relative w-full max-w-[380px] lg:max-w-[420px] xl:max-w-[480px] h-[450px] sm:h-[500px] lg:h-[550px] xl:h-[620px] mt-12 lg:mt-0">
      
      <!-- The Background Shape (Rounded Rectangle) -->
      <div class="absolute inset-x-0 bottom-0 top-12 rounded-[2.5rem] overflow-hidden bg-[#e8e7e5] shadow-2xl shadow-slate-200/50">
        <!-- Overlay the provided background if desired -->
        <img 
          src="/images/Gemini_Generated_Image_iz41bwiz41bwiz41.png" 
          alt="" 
          class="w-full h-full object-cover opacity-60 mix-blend-multiply"
        />
      </div>
      
      <!-- The Transparent Character Image -->
      <img 
        src="/images/Gemini_Generated_Image_iz41bwiz41bwiz41-removebg-preview (1).png" 
        alt="Smiling man pointing upwards" 
        class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[165%] lg:w-[165%] max-w-none h-auto object-bottom z-10 pointer-events-none drop-shadow-xl"
      />
      
      <!-- The Bottom Fade -->
      <div class="absolute inset-x-0 -bottom-1 h-32 bg-gradient-to-t from-[#f8f9fc] via-[#f8f9fc]/90 to-transparent z-20 pointer-events-none rounded-b-[2.5rem]"></div>
    </div>
  </div>
</section>

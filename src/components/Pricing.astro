---
import { ChevronDown } from "lucide-react";

const plans = [
  {
    name: "Basic",
    description: "Perfect for individuals starting out",
    price: "$0/mo",
    color: "bg-blue-100 text-blue-600"
  },
  {
    name: "Bro",
    description: "Advanced features for professionals",
    price: "$29/mo",
    color: "bg-purple-100 text-purple-600"
  },
  {
    name: "Pro",
    description: "Dedicated support, Olr AI & ...",
    price: "$49/mo",
    color: "bg-emerald-100 text-emerald-600"
  },
  {
    name: "Enterprise",
    description: "Get custom pricing",
    price: "Custom",
    color: "bg-orange-100 text-orange-600"
  }
];
---

<div class="flex flex-col w-full">
  <h2 class="text-3xl font-semibold text-slate-800 mb-8">Trotuchity</h2>
  
  <div class="flex flex-col gap-3">
    {plans.map((plan) => (
      <div class="group flex items-center justify-between p-4 rounded-2xl hover:bg-white hover:shadow-sm border border-transparent hover:border-slate-100 transition-all cursor-pointer">
        <!-- Plan Name -->
        <div class="w-1/4 font-medium text-slate-800">
          {plan.name}
        </div>
        
        <!-- Avatar and Description -->
        <div class="flex-1 flex items-center gap-4">
          <div class={`w-8 h-8 rounded-full flex items-center justify-center text-xs font-bold ${plan.color}`}>
            {plan.name.charAt(0)}
          </div>
          <span class="text-slate-500 text-sm">{plan.description}</span>
        </div>
        
        <!-- Price or Custom Text -->
        <div class="text-slate-400 text-sm font-medium pr-4 hidden sm:block">
          {plan.name === 'Enterprise' ? <span class="text-primary">The Customah Pr</span> : plan.price}
        </div>
        
        <!-- Chevron -->
        <div class="text-slate-300 group-hover:text-slate-600 transition-colors">
          <ChevronDown size={20} />
        </div>
      </div>
    ))}
  </div>
</div>

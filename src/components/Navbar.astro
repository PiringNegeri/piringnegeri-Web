---
import { Command } from "lucide-react";
---

<header
  id="navbar-header"
  class="fixed top-0 left-0 w-full z-50 transition-all duration-300 pt-0 px-0"
>
  <nav
    id="navbar-nav"
    class="mx-auto flex items-center justify-between w-full max-w-[1440px] transition-all duration-300 py-6 px-6 lg:px-12 bg-transparent border border-transparent shadow-none rounded-none"
  >
    <div
      class="flex items-center gap-2 font-bold text-xl tracking-tight text-slate-800"
    >
      <img
        src="/images/piringnegeri_vector.png"
        alt="Piring Negeri Icon"
        class="h-8 w-auto object-contain"
      />
      <img
        src="/images/piringnegeri_text.png"
        alt="Piring Negeri"
        class="h-5 w-auto object-contain mt-0.5"
      />
    </div>

    <div
      class="hidden md:flex items-center gap-8 text-sm font-medium text-black"
    >
      <a href="#" class="no-underline text-black hover:text-[#5885f6] transition-colors">Beranda</a>
      <a href="#" class="no-underline text-black hover:text-[#5885f6] transition-colors">Tentang</a>
      <a href="#" class="no-underline text-black hover:text-[#5885f6] transition-colors">Program</a>
      <a href="#" class="no-underline text-black hover:text-[#5885f6] transition-colors">Laporan</a>
    </div>

    <div>
      <button
        class="bg-[#5885f6] hover:bg-[#4a75e0] text-white text-sm font-medium py-2.5 px-6 rounded-full transition-colors shadow-sm"
      >
        Masuk
      </button>
    </div>
  </nav>
</header>

<script>
  const header = document.getElementById("navbar-header");
  const nav = document.getElementById("navbar-nav");

  if (header && nav) {
    window.addEventListener("scroll", () => {
      if (window.scrollY > 20) {
        header.classList.add("pt-4", "px-4");
        nav.classList.remove(
          "py-6",
          "px-6",
          "lg:px-12",
          "bg-transparent",
          "border-transparent",
          "shadow-none",
          "rounded-none",
          "max-w-[1440px]",
        );
        nav.classList.add(
          "py-4",
          "px-6",
          "lg:px-8",
          "bg-white/70",
          "backdrop-blur-md",
          "border-white/40",
          "shadow-sm",
          "rounded-full",
          "max-w-[1400px]",
        );
      } else {
        header.classList.remove("pt-4", "px-4");
        nav.classList.add(
          "py-6",
          "px-6",
          "lg:px-12",
          "bg-transparent",
          "border-transparent",
          "shadow-none",
          "rounded-none",
          "max-w-[1440px]",
        );
        nav.classList.remove(
          "py-4",
          "px-6",
          "lg:px-8",
          "bg-white/70",
          "backdrop-blur-md",
          "border-white/40",
          "shadow-sm",
          "rounded-full",
          "max-w-[1400px]",
        );
      }
    });
  }
</script>
